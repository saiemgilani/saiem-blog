# deploy/Dockerfile.api — build context: api/
FROM python:3.12-slim
# Pinned to the uv version on the dev box (`uv --version`). Bump deliberately when upgrading uv.
COPY --from=ghcr.io/astral-sh/uv:0.11.10 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev
RUN useradd --system --uid 10001 app
USER app
EXPOSE 8000
CMD ["/app/.venv/bin/saiem-api", "serve", "--host", "0.0.0.0", "--port", "8000"]
