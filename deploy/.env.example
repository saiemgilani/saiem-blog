# deploy/.env.example — copy to deploy/.env on the droplet (chmod 600). Compose reads it for
# ${VAR} interpolation because deploy/ is the project directory. Never commit deploy/.env.
TAG=latest
# host Postgres over the mounted unix socket; the password is hex so it needs no URL-escaping
DATABASE_URL=postgresql://saiem_app:CHANGE_ME@/saiem?host=/var/run/postgresql
SAIEM_API_SECRET=CHANGE_ME_openssl_rand_hex_32
OWNER_GITHUB_ID=
# gated lab (spec §5) -- units/day per user PER ENTRY before a 429 (N-5: not runs/day overall)
LAB_DAILY_QUOTA=5
# monthly spend cap in units (UTC calendar month) before every run 429s regardless of quota left
SPEND_UNITS_CAP=2000
# a runner is killed and settled as an error past this many seconds
LAB_RUN_TIMEOUT_S=30
# lab_runs rows older than this are purged by the daily timer (see §7)
RUN_RETENTION_DAYS=90
# "off"/"false"/"0"/"no" (case-insensitive) pauses gated runs; anything else, including unset, is live.
# This is the AUTHORITATIVE kill switch for reserve/runs/chat -- Vercel's LAB_LIVE_RUNS (mode A) is
# only a UI-side mirror that short-circuits before the API is ever called. Flipping this needs a
# container recreate (`docker compose up -d api`), not just a compose reload -- Settings is read
# once at process start.
LAB_LIVE_RUNS=on
# caps concurrent python runner children, non-blocking (503 {"busy": true} when full, nothing
# charged). Default is 2 if unset -- sized against the 512m container's memory limit.
# LAB_MAX_CONCURRENT_RUNS=2
# mode B only (the web container signs in users itself; in mode A these live on Vercel)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# mode B only: the web container's AI Gateway auth (Vercel OIDC covers this on Vercel itself) and
# the LLM model allowlist for № 003 (in mode A these live on Vercel, see runbook §6)
AI_GATEWAY_API_KEY=
LAB_LLM_MODELS=
# mode B optional (the web container's frontend code reads these directly; both are wired
# through in deploy/compose.yml's web.environment and each falls back if unset):
# VIEWS_HASH_SECRET     -- falls back to SAIEM_API_SECRET
# LAB_DATA_RATE_PER_MIN -- falls back to 120 (requests/min per IP on /api/lab/data)
VIEWS_HASH_SECRET=
LAB_DATA_RATE_PER_MIN=
