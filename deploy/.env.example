# deploy/.env.example — copy to deploy/.env on the droplet (chmod 600). Compose reads it for
# ${VAR} interpolation because deploy/ is the project directory. Never commit deploy/.env.
TAG=latest
# host Postgres over the mounted unix socket; the password is hex so it needs no URL-escaping
DATABASE_URL=postgresql://saiem_app:CHANGE_ME@/saiem?host=/var/run/postgresql
SAIEM_API_SECRET=CHANGE_ME_openssl_rand_hex_32
OWNER_GITHUB_ID=
# mode B only (the web container signs in users itself; in mode A these live on Vercel)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
