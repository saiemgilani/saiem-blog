# deploy/.env.example — copy to deploy/.env on the droplet (chmod 600). Compose reads it for
# ${VAR} interpolation because deploy/ is the project directory. Never commit deploy/.env.
TAG=latest
# host Postgres over the mounted unix socket; the password is hex so it needs no URL-escaping
DATABASE_URL=postgresql://saiem_app:CHANGE_ME@/saiem?host=/var/run/postgresql
SAIEM_API_SECRET=CHANGE_ME_openssl_rand_hex_32
OWNER_GITHUB_ID=
# gated lab (spec §5) -- runs/day per user before a 429
LAB_DAILY_QUOTA=5
# monthly spend cap in units (UTC calendar month) before every run 429s regardless of quota left
SPEND_UNITS_CAP=2000
# a runner is killed and settled as an error past this many seconds
LAB_RUN_TIMEOUT_S=30
# lab_runs rows older than this are purged by the daily timer (see §7)
RUN_RETENTION_DAYS=90
# "off"/"false"/"0"/"no" (case-insensitive) pauses gated runs; anything else, including unset, is live
LAB_LIVE_RUNS=on
# mode B only (the web container signs in users itself; in mode A these live on Vercel)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
