# P1 needs no environment variables. P4 adds API_BASE_URL, SAIEM_API_SECRET, AUTH_*.

# saiem-api (server-only; unset = counter hidden, /work shows no projects). Production-only on Vercel.
API_BASE_URL=http://127.0.0.1:8100
SAIEM_API_SECRET=dev-secret-not-for-production
# Separate secret for hashing visitor IPs (optional; falls back to SAIEM_API_SECRET). Keeps the
# droplet from being able to reverse visitor hashes if SAIEM_API_SECRET ever leaks.
VIEWS_HASH_SECRET=

# GitHub OAuth app; callback https://www.saiemgilani.com/api/auth/callback/github (+ http://localhost:3000/… for dev)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
